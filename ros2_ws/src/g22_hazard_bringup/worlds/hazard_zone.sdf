            </link>
            <link name="wall_east">
                <pose>15 0 1.25 0 0 0</pose>
                <collision name="collision">
                    <geometry><box><size>0.4 24 2.5</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><mesh><uri>model://g22_decor/meshes/wall_ew.obj</uri></mesh></geometry>
